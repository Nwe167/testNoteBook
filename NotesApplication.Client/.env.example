# Base URL for the Notes CRUD API (ASP.NET Core), e.g. GET /api/Notes, /api/Notes/1
VITE_API_BASE_URL=https://localhost:7057/api

# Base URL for the Auth API. Some setups run this as a separate process/port
# (e.g. https://localhost:5096) — point this at wherever /api/auth/login lives.
VITE_AUTH_BASE_URL=https://localhost:7057/api
